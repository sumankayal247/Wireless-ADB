#!/usr/bin/env bash
# scrcpyqr: A wrapper script to pair an Android device via QR code and launch scrcpy

# Store any arguments passed to the script to forward to scrcpy
SCRCPY_ARGS=("$@")

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- Initialization ---
if [ -d "$HOME/.local/platform-tools" ]; then
    export PATH="$HOME/.local/platform-tools:$PATH"
fi

if ! command -v scrcpy >/dev/null 2>&1; then
    echo -e "${RED}Error: 'scrcpy' is not installed.${NC}"
    exit 1
fi

if ! command -v adb >/dev/null 2>&1; then
    echo -e "${RED}Error: 'adb' is not installed.${NC}"
    exit 1
fi

check_and_fix_mdns() {
    MDNS_OUTPUT=$(adb mdns check 2>&1)
    if [[ -z "$MDNS_OUTPUT" || "$MDNS_OUTPUT" == *"error"* ]]; then
        echo -e "${YELLOW}Warning: Your system's version of ADB does not support mDNS network discovery.${NC}"
        read -p "Would you like to automatically download the official Google ADB to fix this? (Y/n): " dl_choice
        if [[ "$dl_choice" == "y" || "$dl_choice" == "Y" || "$dl_choice" == "" ]]; then
            echo -e "${CYAN}Downloading official Android Platform Tools...${NC}"
            mkdir -p /tmp/scrcpyqr_dl
            
            # macOS vs Linux download link
            if [ "$(uname -s)" = "Darwin" ]; then
                DL_URL="https://dl.google.com/android/repository/platform-tools-latest-darwin.zip"
            else
                DL_URL="https://dl.google.com/android/repository/platform-tools-latest-linux.zip"
            fi
            
            curl -L -s --progress-bar "$DL_URL" -o /tmp/scrcpyqr_dl/platform-tools.zip
            echo -e "${CYAN}Extracting to ~/.local/platform-tools...${NC}"
            mkdir -p "$HOME/.local"
            unzip -q -o /tmp/scrcpyqr_dl/platform-tools.zip -d "$HOME/.local/"
            export PATH="$HOME/.local/platform-tools:$PATH"
            rm -rf /tmp/scrcpyqr_dl
            echo -e "${GREEN}Official ADB installed successfully!${NC}"
        else
            return 1
        fi
    fi
    return 0
}

clear
echo -e "${CYAN}========================================${NC}"
echo -e "${GREEN}          scrcpyqr Setup                ${NC}"
echo -e "${CYAN}========================================${NC}"
echo "How would you like to connect your phone?"
echo ""
echo -e "${YELLOW}--- Initial Setup (First Time) ---${NC}"
echo "1. Scan QR Code (Automatic pairing - Recommended)"
echo "2. Enter Pairing Code (Manual pairing - Fallback)"
echo ""
echo -e "${YELLOW}--- Daily Use ---${NC}"
echo "3. Quick Connect (Already Paired)"
echo -e "${CYAN}========================================${NC}"
read -p "Choose an option (1, 2, or 3): " OPTION
echo ""

if [ "$OPTION" = "1" ]; then
    if ! check_and_fix_mdns; then
        echo -e "${RED}QR Code pairing requires mDNS. Please use Option 2.${NC}"
        exit 1
    fi

    if ! command -v qrencode >/dev/null 2>&1; then
        echo -e "${RED}Error: 'qrencode' is not installed.${NC}"
        exit 1
    fi

    NAME="scrcpy-$(printf '%04x' "$RANDOM")"
    CODE=$(( (RANDOM * 32768 + RANDOM) % 900000 + 100000 ))
    PAYLOAD="WIFI:T:ADB;S:$NAME;P:$CODE;;"

    echo -e "${CYAN}1. Connect PC and Phone to the SAME Wi-Fi network.${NC}"
    echo -e "${CYAN}2. On your phone: Developer options > Wireless debugging > Pair device with QR code${NC}"
    echo ""

    QR_IMAGE="/tmp/scrcpyqr.png"
    qrencode -m 4 -l Q -o "$QR_IMAGE" "$PAYLOAD"

    if command -v open >/dev/null 2>&1; then
        open "$QR_IMAGE" 2>/dev/null &  # macOS
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$QR_IMAGE" 2>/dev/null &  # Linux
    else
        echo -e "${YELLOW}Please manually open this image: $QR_IMAGE${NC}"
    fi

    echo -e "${YELLOW}Waiting for phone to scan... (Ctrl-C to cancel)${NC}"

    ADDR=""
    for i in {1..60}; do
        ADDR=$(adb mdns services 2>/dev/null | awk '/_adb-tls-pairing\._tcp/ {print $3; exit}')
        if [ -n "$ADDR" ]; then
            break
        fi
        sleep 1
    done

    if [ -z "$ADDR" ]; then
        echo -e "${RED}Timeout! No pairing request detected.${NC}"
        exit 1
    fi

    echo -e "${GREEN}Phone detected at $ADDR. Pairing...${NC}"
    adb pair "$ADDR" "$CODE" > /dev/null

elif [ "$OPTION" = "2" ]; then
    echo -e "${CYAN}1. Connect PC and Phone to the SAME Wi-Fi network.${NC}"
    echo -e "${CYAN}2. On your phone: Developer options > Wireless debugging > Pair device with pairing code${NC}"
    echo ""
    read -p "Enter IP address & Port (e.g. 192.168.1.5:43123): " ADDR
    read -p "Enter 6-digit Wi-Fi pairing code: " CODE
    
    echo -e "${YELLOW}Pairing with $ADDR...${NC}"
    adb pair "$ADDR" "$CODE"

elif [ "$OPTION" = "3" ]; then
    echo -e "${CYAN}--- Quick Connect ---${NC}"
else
    echo -e "${RED}Invalid option selected.${NC}"
    exit 1
fi

if [ "$OPTION" = "1" ] || [ "$OPTION" = "2" ]; then
    if [ $? -ne 0 ]; then
        echo -e "${RED}Pairing failed.${NC}"
        exit 1
    fi
    echo -e "${GREEN}Pairing successful! Waiting for device to finalize...${NC}"
    sleep 2
fi

DEVICE_COUNT=$(adb devices | grep -v "List of devices attached" | grep -w "device$" | wc -l)

if [ "$DEVICE_COUNT" -eq 0 ]; then
    CONNECT_ADDR=""
    
    # Try to auto-detect connection port using mDNS
    echo -e "${YELLOW}Scanning network for available devices...${NC}"
    MDNS_CONNECT_ADDR=$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect\._tcp/ {print $3; exit}')
    
    if [ -n "$MDNS_CONNECT_ADDR" ]; then
        echo -e "${GREEN}Found device broadcasting at ${MDNS_CONNECT_ADDR}!${NC}"
        read -p "Connect to this device? (Y/n): " auto_conn
        if [[ "$auto_conn" == "y" || "$auto_conn" == "Y" || "$auto_conn" == "" ]]; then
            CONNECT_ADDR="$MDNS_CONNECT_ADDR"
        fi
    fi
    
    # Fallback to manual entry if not found or user declined
    if [ -z "$CONNECT_ADDR" ]; then
        echo ""
        echo -e "${CYAN}Look at the main 'Wireless debugging' screen on your phone.${NC}"
        read -p "Enter the IP address & Port (e.g. 192.168.1.5:38421): " CONNECT_ADDR
    fi

    if [ -n "$CONNECT_ADDR" ]; then
        adb connect "$CONNECT_ADDR"
        sleep 1
    else
        echo -e "${RED}Could not find the connect port.${NC}"
        exit 1
    fi
fi

DEVICE_COUNT=$(adb devices | grep -v "List of devices attached" | grep -w "device$" | wc -l)
if [ "$DEVICE_COUNT" -eq 0 ]; then
    echo -e "${RED}Failed to connect to the device. Please try again.${NC}"
    exit 1
fi

echo -e "${GREEN}Successfully connected! Starting scrcpy...${NC}"
# Pass any custom arguments provided by the user (e.g. scrcpyqr --turn-screen-off)
scrcpy -e "${SCRCPY_ARGS[@]}"
